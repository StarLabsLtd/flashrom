+enum usb_spi_error {
+	USB_SPI_SUCCESS                 = 0x0000,
+	USB_SPI_TIMEOUT                 = 0x0001,
+	USB_SPI_BUSY                    = 0x0002,
+	USB_SPI_WRITE_COUNT_INVALID     = 0x0003,
+	USB_SPI_READ_COUNT_INVALID      = 0x0004,
+	USB_SPI_DISABLED                = 0x0005,
