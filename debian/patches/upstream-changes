+fn decode_test_result(res: TestResult, con: TestConclusion) -> (TestConclusion, Option<TestError>) {
+    use TestConclusion::*;
+
+    match (res, con) {
+        (Ok(_), Fail) => (UnexpectedPass, None),
+        (Err(e), Pass) => (UnexpectedFail, Some(e)),
+        _ => (Pass, None),
+    }
+}
